# 工作区元数据（不应入库）
.workbuddy/

# ── 文档同步规则（用户明确，长期有效）────────────────────────
# 本仓库 git 里**只保留 README.md 一个 .md**：它是面向使用者/协作者的脚本清单与部署说明。
# 其余 md 与本地运行/归档有关，一律只留本地：
#   AGENTS.md      —— 工作区结构 / Agent 规则 / 内网对接口径（只给本机 Agent 看）
#   archive/       —— 已停用历史脚本 + 其 NOTE/README（降低本地找回成本，不参与运行）
# 详见 AGENTS.md §8.5.1。
AGENTS.md
archive/

# 失效/无法运行的链路：仅保留本地，不入库
# 翼支付 MGS 全链路（yzf_sign.py -> yzf_mgs_client.js -> yzf_js/），实测已失效
ql/yzf_js/
ql/yzf_mgs_client.js
ql/yzf_sign.py

# 凭据 / 登录态缓存（青龙脚本运行时会生成）
.env
*.env
auth.json
*.token
*.cookie

# 设备指纹缓存（按账号持久化，属设备指纹类数据，不入库）
# wc_sign.py 首次运行时在其所在目录生成
ql/.wc_device.json
ql/.wc_device.json.tmp

# 本地配置
config.local.*
*.local

# 运行产物
__pycache__/
*.pyc
node_modules/
*.log
.DS_Store
Thumbs.db
