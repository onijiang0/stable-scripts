// [title: 服务器监控预警]
// [name: server_monitor]
// [desc: 定时检测服务器状态并发送资源预警，支持进程与Docker监控]
// [author: Gemini]
// [version: v1.0.0]
// [cron: */5 * * * *]
// [rule: ^(服务器状态|监控查询)$]
// [admin: true]
// [status: true]
// [public: false]
// [priority: 1]
// [class: 运维工具]
// [icon: https://api.iconify.design/lucide:activity.svg]
// [depe: []]

const os = require('os');
const { execSync } = require('child_process');
const { sender: s, plugin, Bucket } = require("sillygirl");

// 1. 可视化配置表单
const config = new plugin.Form({
  enable: plugin.Form.boolean().title("是否启用监控").default(true),
  mem_normal: plugin.Form.integer().title("内存普通提醒阈值(%)").default(80),
  mem_high: plugin.Form.integer().title("内存高危告警阈值(%)").default(90),
  mem_critical: plugin.Form.integer().title("内存紧急告警阈值(%)").default(95),
  cpu_threshold: plugin.Form.integer().title("CPU高危告警阈值(%)").default(85),
  disk_threshold: plugin.Form.integer().title("磁盘占用告警阈值(%)").default(90),
  cooldown_mins: plugin.Form.integer().title("相同告警冷却期(分钟)").default(30),
  processes: plugin.Form.string().title("监控进程(逗号分隔,如: nginx,mysql)").default(""),
  containers: plugin.Form.string().title("监控容器(逗号分隔,如: qinglong,redis)").default(""),
});

const BUCKET_NAME = "server_monitor_state";

async function main() {
  const conf = await config.get();
  if (conf.enable === false) return;

  // 区分是用户手动查询还是 cron 定时触发
  const command = String(await s.getMsg().catch(() => "")).trim();
  const isManual = !!command;

  if (isManual && !(await s.isAdmin())) {
    await s.reply("仅管理员可用");
    return;
  }

  // 2. 收集系统指标
  const hostname = os.hostname();
  const timeStr = formatTime(new Date());
  
  const { memUsage, memLevel, riskLevel } = checkMemory(conf);
  const { cpuUsage, cpuHigh } = await checkCPU(conf);
  const { diskUsage, diskHigh } = checkDisk(conf);
  const { serviceStatus, hasServiceError } = checkServices(conf);

  let currentRisk = "正常";
  if (riskLevel === "紧急告警" || cpuHigh || hasServiceError) currentRisk = "紧急告警";
  else if (riskLevel === "高危告警" || diskHigh) currentRisk = "高危告警";
  else if (riskLevel === "普通提醒") currentRisk = "普通提醒";

  // 3. 构建消息格式
  const output = [
    "【服务器预警】",
    `服务器：${hostname}`,
    `时间：${timeStr}`,
    `CPU：${cpuUsage}%`,
    `内存：${memUsage}%`,
    `磁盘：${diskUsage}%`,
    `状态：\n${serviceStatus.join("\n")}`,
    `风险等级：${currentRisk}`
  ].join("\n");

  // 4. 触发逻辑
  if (isManual) {
    // 手动查询直接返回
    return s.reply(output);
  } else {
    // 定时任务：仅在异常时且通过冷却期限制才推送
    if (currentRisk !== "正常") {
      const shouldSend = await checkCooldown(currentRisk, conf.cooldown_mins);
      if (shouldSend) {
        await s.pushAdmin(output); // 推送给管理员
      }
    } else {
      // 若恢复正常，清理冷却状态
      await resetCooldown();
    }
  }
}

// ---- 检测功能实现 ----

function checkMemory(conf) {
  const total = os.totalmem();
  const free = os.freemem();
  const usedPercent = Number(((total - free) / total * 100).toFixed(1));
  
  let riskLevel = "正常";
  if (usedPercent >= conf.mem_critical) riskLevel = "紧急告警";
  else if (usedPercent >= conf.mem_high) riskLevel = "高危告警";
  else if (usedPercent >= conf.mem_normal) riskLevel = "普通提醒";

  return { memUsage: usedPercent, memLevel: riskLevel, riskLevel };
}

// 采用采样计算一段时间内的 CPU 使用率，过滤瞬时毛刺
function checkCPU(conf) {
  return new Promise((resolve) => {
    const start = getCPUInfo();
    setTimeout(() => {
      const end = getCPUInfo();
      const idleDiff = end.idle - start.idle;
      const totalDiff = end.total - start.total;
      const usage = Number((100 - (100 * idleDiff / totalDiff)).toFixed(1));
      resolve({
        cpuUsage: usage,
        cpuHigh: usage >= conf.cpu_threshold
      });
    }, 1000); // 1秒采样
  });
}

function getCPUInfo() {
  const cpus = os.cpus();
  let idle = 0, total = 0;
  for (let cpu of cpus) {
    for (let type in cpu.times) {
      total += cpu.times[type];
    }
    idle += cpu.times.idle;
  }
  return { idle, total };
}

function checkDisk(conf) {
  try {
    // 获取根目录 / 的使用率，适用于大多数 Linux
    const res = execSync("df / | awk 'NR==2 {print $5}'").toString().trim();
    const usageStr = res.replace('%', '');
    const usage = Number(usageStr) || 0;
    return {
      diskUsage: usage,
      diskHigh: usage >= conf.disk_threshold
    };
  } catch (e) {
    return { diskUsage: "获取失败", diskHigh: false };
  }
}

function checkServices(conf) {
  let statusList = [];
  let hasError = false;

  // 检查进程
  if (conf.processes) {
    const procs = conf.processes.split(',').map(p => p.trim()).filter(Boolean);
    procs.forEach(proc => {
      try {
        execSync(`pgrep -x "${proc}"`);
        statusList.push(`✅ 进程 [${proc}] 运行中`);
      } catch (e) {
        statusList.push(`❌ 进程 [${proc}] 异常退出!`);
        hasError = true;
      }
    });
  }

  // 检查 Docker 容器
  if (conf.containers) {
    const containers = conf.containers.split(',').map(c => c.trim()).filter(Boolean);
    containers.forEach(container => {
      try {
        const isRunning = execSync(`docker inspect -f '{{.State.Running}}' ${container} 2>/dev/null`).toString().trim();
        if (isRunning === 'true') {
          statusList.push(`✅ 容器 [${container}] 运行中`);
        } else {
          statusList.push(`❌ 容器 [${container}] 已停止!`);
          hasError = true;
        }
      } catch (e) {
        statusList.push(`⚠️ 容器 [${container}] 不存在或无权限`);
      }
    });
  }

  if (statusList.length === 0) statusList.push("系统基础运行正常");

  return { serviceStatus: statusList, hasServiceError: hasError };
}

// ---- 防刷冷却管理 ----

async function checkCooldown(currentRisk, cooldownMins) {
  const bucket = new Bucket(BUCKET_NAME);
  const stateStr = await bucket.get("last_alert", "{}");
  let state = {};
  try { state = JSON.parse(stateStr); } catch(e){}

  const now = Date.now();
  const lastTime = state.time || 0;
  const lastRisk = state.risk || "";

  // 如果风险等级变高（如从 普通 -> 紧急），无视冷却时间，立即报警
  const riskWeights = { "正常": 0, "普通提醒": 1, "高危告警": 2, "紧急告警": 3 };
  if (riskWeights[currentRisk] > riskWeights[lastRisk]) {
    await bucket.set("last_alert", JSON.stringify({ time: now, risk: currentRisk }));
    return true;
  }

  // 仍在同一等级内，判断是否过冷却期
  if (now - lastTime > cooldownMins * 60 * 1000) {
    await bucket.set("last_alert", JSON.stringify({ time: now, risk: currentRisk }));
    return true;
  }
  
  return false;
}

async function resetCooldown() {
  const bucket = new Bucket(BUCKET_NAME);
  await bucket.set("last_alert", JSON.stringify({ time: 0, risk: "正常" }));
}

function formatTime(date) {
  const p = v => String(v).padStart(2, '0');
  return `${date.getFullYear()}-${p(date.getMonth()+1)}-${p(date.getDate())} ${p(date.getHours())}:${p(date.getMinutes())}:${p(date.getSeconds())}`;
}

main().catch((error) => console.error("服务器监控预警异常:", error));
